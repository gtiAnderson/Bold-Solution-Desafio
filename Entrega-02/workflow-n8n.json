      "parameters": {
        "jsCode": "const statusValidos = [\n  'aberto',\n  'em_atendimento',\n  'aguardando_cliente',\n  'resolvido',\n  'cancelado'\n];\n\nconst body = $json.body || {};\nconst id = $json.params?.id;\nconst status = body.status;\n\nif (!id) {\n  return [{\n    json: {\n      erro: true,\n      mensagem: 'ID do ticket é obrigatório.'\n    }\n  }];\n}\n\nif (!status || !statusValidos.includes(status)) {\n  return [{\n    json: {\n      erro: true,\n      mensagem: 'Status inválido. Valores aceitos: ' + statusValidos.join(', ')\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    erro: false,\n    id: Number(id),\n    status\n  }\n}];"
      },
