    {
      "parameters": {
        "jsCode": "const ticket = $('Buscar ticket pelo id').first().json;\nconst cliente = $('Buscar cliente pelo id').first().json;\n\nconst interacoes = $input.all()\n  .map(item => item.json)\n  .filter(item => item.id);\n\nreturn [\n  {\n    json: {\n      ...ticket,\n      cliente_nome: cliente.nome,\n      cliente_email: cliente.email,\n      cliente_telefone: cliente.telefone,\n      interacoes\n    }\n  }\n];"
      },
