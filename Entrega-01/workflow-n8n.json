      "id": "97675144-6b17-4490-b6fc-55926bab5eab",
      "name": "Create Cliente",
      "credentials": {
        "supabaseApi": {
          "id": "VDnAIQBnKH0CGYjG",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const query = $('Get tickets').first().json.query || {};\n\nconst status = query.status;\nconst prioridade = query.prioridade;\n\nconst tickets = $input.all();\n\nconst filtrados = tickets.filter(item => {\n  const ticket = item.json;\n\n  const statusOk = !status || ticket.status === status;\n  const prioridadeOk = !prioridade || ticket.prioridade === prioridade;\n\n  return statusOk && prioridadeOk;\n});\n\nreturn filtrados;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        912
      ],
      "id": "350b1ce5-da18-4402-b6e5-72101138807c",
      "name": "Filtragem"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "tickets",
        "returnAll": true,
        "matchType": "allFilters"
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -16,
        912
      ],
      "id": "490fcd26-0246-4373-b79a-726a0858f5b5",
      "name": "Busca Tickets",
      "credentials": {
        "supabaseApi": {
          "id": "VDnAIQBnKH0CGYjG",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body;\n\nif (!body.cliente_id || !body.titulo || !body.descricao) {\n  return [{ json: { erro: true, mensagem: 'Campos cliente_id, titulo e descricao são obrigatórios.' } }];\n}\n\nconst ano = new Date().getFullYear();\nconst timestamp = Date.now().toString().slice(-6);\nconst protocolo = `TCK-${ano}-${timestamp}`;\n\nreturn [{\n  json: {\n    cliente_id: body.cliente_id,\n    titulo: body.titulo,\n    descricao: body.descricao,\n    prioridade: body.prioridade || 'media',\n    status: 'aberto',\n    protocolo: protocolo\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        592
      ],
      "id": "d0f6c396-c9cc-46d5-b84f-d540f67e88ae",
      "name": "Detecta Campos Obrigatorios"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body;\n\nconst camposObrigatorios = ['nome', 'email', 'telefone'];\n\nconst camposFaltando = camposObrigatorios.filter(\n  campo => !body?.[campo] || String(body[campo]).trim() === ''\n);\n\nif (camposFaltando.length > 0) {\n  return [\n    {\n      json: {\n        sucesso: false,\n        erro: 'Dados obrigatórios não informados.',\n        campos_faltando: camposFaltando\n      }\n    }\n  ];\n}\n\nreturn [\n  {\n    json: {\n      sucesso: true,\n      body\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        48
      ],
      "id": "1929d4b1-2f28-4560-ac05-b6531aeab67f",
      "name": "Detecta Campos Obrigatórios"
    }
  ],
